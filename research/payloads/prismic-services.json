        "call_us_two_title": [
          {
            "type": "heading2",
            "text": "YOU WANT TO CAPTURE\n→ THE IMAGINATION",
            "spans": []
          }
        ],
        "call_us_two_baseline": "[ WE ARE DESIGN - DRIVEN ]",
        "call_us_two_text": [
          {
            "type": "paragraph",
            "text": "We approach problems visually. In a scroll-through world, we aim for instant visceral impact. Our work is designed to speak to the imagination of global audiences.",
            "spans": []
          },
          {
            "type": "paragraph",
            "text": "Design-driven work allows us to inject personality into every interaction. To bring character to an otherwise templated world. To challenge the codes of a category and establish the brand as a leader within it.",
            "spans": []
          }
        ],
        "call_us_two_quote": [
          {
            "type": "paragraph",
            "text": "“We believe in visual ideas that travel globally and work instantly. monopo is able to boil down our innovation stories into striking visuals that resonate in any culture.”",
            "spans": []
          }
        ],
        "call_us_two_quote_author": [
          {
            "type": "paragraph",
            "text": "Casey Yoneyama,\nbrand director at YONEX",
            "spans": []
          }
        ],
